{
  "name": "mydevtime",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Cross-platform time tracking (iOS + Android + Web) — TypeScript monorepo. See docs/architecture.md and ADR-0003/0014.",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22",
    "pnpm": ">=10"
  },
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "build": "pnpm -r --if-present build",
    "check:docs": "node scripts/check-docs.mjs",
    "diagrams": "node scripts/gen-diagrams.mjs",
    "check:diagrams": "node scripts/gen-diagrams.mjs --check",
    "check:purity": "node scripts/check-domain-purity.mjs",
    "check:req-coverage": "node scripts/check-req-coverage.mjs",
    "check:adherence": "node scripts/check-design-adherence.mjs",
    "gate": "./test.sh",
    "prepare": "node scripts/install-hooks.mjs",
    "db:seed": "pnpm --filter @mydevtime/api db:seed",
    "docker": "./scripts/docker.sh"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@mermaid-js/mermaid-cli": "^12.0.0",
    "@swc/core": "^1.16.13",
    "@testing-library/react-native": "14.0.1",
    "@types/node": "^26.6.4",
    "@types/react-test-renderer": "19.3.0",
    "@vitest/coverage-v8": "^5.0.3",
    "eslint": "^10.12.0",
    "fast-check": "^4.10.2",
    "globals": "^17.13.0",
    "jsdom": "^30.1.1",
    "prettier": "^3.9.9",
    "react-test-renderer": "19.3.0",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.71.0",
    "unplugin-swc": "^2.0.0",
    "vitest": "^5.0.3"
  },
  "resolutions": {
    "vite": ">=6.4.3",
    "@xmldom/xmldom": ">=0.8.15",
    "@expo/plist>@xmldom/xmldom": "0.8.15",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "tar": ">=7.5.21",
    "fast-uri": "^3.1.4",
    "brace-expansion": ">=5.0.8",
    "find-my-way": ">=9.7.0",
    "postcss": ">=8.5.18",
    "fastify": "^5.12.1",
    "js-yaml@4": "^4.3.2"
  }
}
